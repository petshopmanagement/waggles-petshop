@model PetManagementSystem.Web.Models.PetViewModel
@{
    ViewData["Title"] = "Supply New Pet";
}

<div class="row mb-5">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active">New Supply</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1">Supply New Pet</h2>
        <p class="text-muted">Fill in the details to add a new companion to Waggles Pet Shop.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="custom-card border-0 shadow-sm p-5">
            <form asp-action="AddPet" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold small text-uppercase">Pet Name</label>
                        <input asp-for="Name" class="form-control bg-light border-0 py-2" placeholder="e.g. Max" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Breed" class="form-label fw-bold small text-uppercase">Breed</label>
                        <input asp-for="Breed" class="form-control bg-light border-0 py-2" placeholder="e.g. Golden Retriever" required />
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Age" class="form-label fw-bold small text-uppercase">Age (Years)</label>
                        <input asp-for="Age" type="number" class="form-control bg-light border-0 py-2" placeholder="e.g. 2" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold small text-uppercase">Price ($)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control bg-light border-0 py-2" placeholder="e.g. 500.00" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-bold small text-uppercase">Image URL</label>
                    <input asp-for="ImageUrl" class="form-control bg-light border-0 py-2" placeholder="https://example.com/image.jpg" />
                    <small class="text-muted">Link to a high-quality photo of the pet.</small>
                </div>

                <div class="mb-5">
                    <label asp-for="Description" class="form-label fw-bold small text-uppercase">Description</label>
                    <textarea asp-for="Description" class="form-control bg-light border-0 py-2" rows="4" placeholder="Tell us about the pet's personality, habits, etc."></textarea>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">
                        Submit Supply
                    </button>
                    <a asp-action="Dashboard" class="btn btn-light rounded-pill px-5 py-2 fw-bold text-muted">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="custom-card border-0 shadow-sm bg-primary bg-opacity-10">
            <h5 class="fw-bold mb-4 text-primary">Supply Guidelines</h5>
            <ul class="list-unstyled d-flex flex-column gap-3 small">
                <li class="d-flex gap-2">
                    <i class="fa-solid fa-circle-check text-primary mt-1"></i>
                    <span>Ensure all health certificates are up to date before delivery.</span>
                </li>
                <li class="d-flex gap-2">
                    <i class="fa-solid fa-circle-check text-primary mt-1"></i>
                    <span>Use clear, well-lit photos for the marketplace listing.</span>
                </li>
                <li class="d-flex gap-2">
                    <i class="fa-solid fa-circle-check text-primary mt-1"></i>
                    <span>Describe the pet's temperament accurately for potential adopters.</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
