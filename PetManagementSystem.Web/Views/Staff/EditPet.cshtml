@model PetManagementSystem.Web.Models.PetViewModel
@{
    ViewData["Title"] = "Edit Pet";
}

<div class="row mb-5">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-action="Inventory" class="text-decoration-none">Inventory</a></li>
                <li class="breadcrumb-item active">Edit Pet</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1">Edit Pet Details</h2>
        <p class="text-muted">Modify the information for @Model.Name.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="custom-card border-0 shadow-sm p-5">
            <form asp-action="EditPet" method="post">
                <input type="hidden" asp-for="PetId" />
                
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold small text-uppercase">Pet Name</label>
                        <input asp-for="Name" class="form-control bg-light border-0 py-2" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Breed" class="form-label fw-bold small text-uppercase">Breed</label>
                        <input asp-for="Breed" class="form-control bg-light border-0 py-2" required />
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Age" class="form-label fw-bold small text-uppercase">Age (Years)</label>
                        <input asp-for="Age" type="number" class="form-control bg-light border-0 py-2" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold small text-uppercase">Price ($)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control bg-light border-0 py-2" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-bold small text-uppercase">Image URL</label>
                    <input asp-for="ImageUrl" class="form-control bg-light border-0 py-2" />
                </div>

                <div class="mb-5">
                    <label asp-for="Description" class="form-label fw-bold small text-uppercase">Description</label>
                    <textarea asp-for="Description" class="form-control bg-light border-0 py-2" rows="4"></textarea>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">
                        Save Changes
                    </button>
                    <a asp-action="Inventory" class="btn btn-light rounded-pill px-5 py-2 fw-bold text-muted">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="custom-card border-0 shadow-sm text-center p-5">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=800&q=80" : Model.ImageUrl)" 
                 class="img-fluid rounded-4 mb-4 shadow-sm" alt="Preview">
            <h6 class="fw-bold mb-1">Current Image Preview</h6>
            <p class="text-muted small">This is how the pet appears in the marketplace.</p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
