@using System.Text.Json
@{
    ViewData["Title"] = "Service Board";
    var grooming = ViewBag.Grooming as JsonElement?;
    var vaccinations = ViewBag.Vaccinations as JsonElement?;
}

<div class="row mb-5">
    <div class="col-12">
        <h2 class="fw-bold mb-1">Service Board</h2>
        <p class="text-muted">Monitor grooming appointments and health procedures.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Grooming Services Section -->
    <div class="col-lg-6">
        <div class="custom-card border-0 shadow-sm p-0 overflow-hidden">
            <div class="p-4 border-bottom bg-white">
                <h5 class="fw-bold mb-0 text-primary"><i class="fa-solid fa-scissors me-2"></i>Grooming Services</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase text-muted fw-bold">
                            <th class="ps-4">Service</th>
                            <th>Description</th>
                            <th class="pe-4 text-end">Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (grooming != null && grooming.Value.TryGetProperty("data", out var gData))
                        {
                            foreach (var item in gData.EnumerateArray())
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@item.GetProperty("name")</td>
                                    <td class="small text-muted">@item.GetProperty("description")</td>
                                    <td class="pe-4 text-end fw-bold">$@item.GetProperty("price")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Vaccinations Section -->
    <div class="col-lg-6">
        <div class="custom-card border-0 shadow-sm p-0 overflow-hidden">
            <div class="p-4 border-bottom bg-white">
                <h5 class="fw-bold mb-0 text-success"><i class="fa-solid fa-syringe me-2"></i>Available Vaccinations</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase text-muted fw-bold">
                            <th class="ps-4">Vaccine</th>
                            <th class="pe-4">Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (vaccinations != null && vaccinations.Value.TryGetProperty("data", out var vData))
                        {
                            foreach (var item in vData.EnumerateArray())
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@item.GetProperty("name")</td>
                                    <td class="pe-4 small text-muted">@item.GetProperty("description")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
