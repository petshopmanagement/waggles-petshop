@model PetManagementSystem.Web.Models.EmployeeViewModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="row mb-5">
    <div class="col-12">
        <h2 class="fw-bold mb-1">Welcome, @Model.FirstName </h2>
        <p class="text-muted">Here's a quick overview of your account.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Profile Card -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">
            <div class="mb-3">
                <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center"
                     style="width:80px; height:80px;">
                    <i class="fa-solid fa-user fa-2x text-primary"></i>
                </div>
            </div>
            <h5 class="fw-bold mb-1">@Model.FullName</h5>
            <p class="text-muted small mb-1">@Model.Position</p>
            <p class="text-muted small">@Model.Email</p>
            <a asp-action="Profile" asp-route-id="@Model.EmployeeId"
                   class="btn btn-outline-primary rounded-pill px-4 mt-2">
                View Full Profile
            </a>
        </div>
    </div>

</div>