@model PetManagementSystem.Web.Models.PetViewModel
@{
    ViewData["Title"] = "Checkout & Payment";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-10">
        <div class="custom-card border-0 shadow-lg p-0 overflow-hidden">
            <div class="row g-0">
                <!-- Summary Side -->
                <div class="col-md-4 bg-primary bg-opacity-10 p-5">
                    <h5 class="fw-bold mb-4">Adoption Summary</h5>
                    <div class="text-center mb-4">
                        <div class="bg-white rounded-4 shadow-sm mb-3 d-flex align-items-center justify-content-center mx-auto" style="width: 150px; height: 150px;">
                            <i class="fa-solid fa-paw fa-4x text-primary opacity-25"></i>
                        </div>
                        <h4 class="fw-bold mb-0">@Model.Name</h4>
                        <p class="text-muted small">@Model.Breed</p>
                    </div>
                    
                    <div class="border-top border-primary border-opacity-10 pt-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Adoption Fee</span>
                            <span class="fw-bold">$@Model.Price</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-muted">Service Tax</span>
                            <span class="fw-bold">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-3">
                            <h5 class="fw-bold">Total</h5>
                            <h5 class="fw-bold text-primary">$@Model.Price</h5>
                        </div>
                    </div>
                </div>

                <!-- Payment Side -->
                <div class="col-md-8 p-5 bg-white">
                    <h3 class="fw-bold mb-4">Choose Payment Method</h3>
                    
                    <form asp-action="ProcessPayment" method="post" id="paymentForm">
                        <input type="hidden" name="petId" value="@Model.PetId" />
                        
                        <!-- Payment Options -->
                        <div class="row g-3 mb-5">
                            <div class="col-md-6">
                                <label class="payment-option w-100 h-100 cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="UPI" class="d-none" checked>
                                    <div class="option-content p-4 border rounded-4 text-center">
                                        <i class="fa-solid fa-mobile-screen-button fa-2x mb-2 text-primary"></i>
                                        <h6 class="fw-bold mb-0">UPI / PhonePe</h6>
                                    </div>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="payment-option w-100 h-100 cursor-pointer">
                                    <input type="radio" name="paymentMethod" value="Card" class="d-none">
                                    <div class="option-content p-4 border rounded-4 text-center">
                                        <i class="fa-solid fa-credit-card fa-2x mb-2 text-muted"></i>
                                        <h6 class="fw-bold mb-0">Debit / Credit Card</h6>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Payment Details -->
                        <div id="upiFields" class="mb-5">
                            <label class="form-label fw-bold small text-uppercase">Enter UPI ID</label>
                            <input type="text" name="paymentDetails" class="form-control bg-light border-0 py-3" placeholder="username@upi" required />
                            <small class="text-muted">Example: 9876543210@ybl or user@okicici</small>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary rounded-pill py-3 fw-bold shadow-sm">
                                Pay $@Model.Price & Confirm Adoption
                            </button>
                        </div>
                        
                        <p class="text-center text-muted small mt-4">
                            <i class="fa-solid fa-shield-halved me-1"></i> Secure 256-bit SSL Encrypted Payment
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .payment-option input:checked + .option-content {
            border-color: var(--primary-color) !important;
            background-color: rgba(255, 77, 109, 0.05);
        }
        .payment-option input:checked + .option-content i {
            color: var(--primary-color) !important;
        }
        .cursor-pointer { cursor: pointer; }
    </style>
    <script>
        // Simple toggle for payment fields
        document.querySelectorAll('input[name="paymentMethod"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
                const upiInput = document.querySelector('input[name="paymentDetails"]');
                if (e.target.value === 'UPI') {
                    upiInput.placeholder = "username@upi";
                } else {
                    upiInput.placeholder = "Card Number: XXXX XXXX XXXX XXXX";
                }
            });
        });
    </script>
}
