@using System.Text.Json
@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Transaction Desk";
    var totalRevenue = (decimal)ViewBag.TotalRevenue;
}

<div class="row mb-5">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Transaction Desk</h2>
        <p class="text-muted">Review and manage the adoption history of Waggles.</p>
    </div>
    <div class="col-md-4 text-md-end">
        <div class="bg-white custom-card d-inline-flex align-items-center gap-3 px-4 py-3 border-0 shadow-sm">
            <div class="bg-success bg-opacity-10 text-success rounded-circle p-2">
                <i class="fa-solid fa-receipt"></i>
            </div>
            <div class="text-start">
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Total Revenue</small>
                <h5 class="fw-bold mb-0 text-dark">$@totalRevenue.ToString("N2")</h5>
            </div>
        </div>
    </div>
</div>

<div class="card custom-card border-0 shadow-sm p-0 overflow-hidden">
    <div class="p-4 border-bottom bg-white d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Adoption Records</h5>
        <div class="d-flex gap-3 align-items-center">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <select name="status" class="form-select border-0 bg-light small rounded-pill px-3" style="width: 150px;" onchange="this.form.submit()">
                    <option value="All" selected="@(Context.Request.Query["status"] == "All")">All Status</option>
                    <option value="Success" selected="@(Context.Request.Query["status"] == "Success")">Success</option>
                    <option value="Failed" selected="@(Context.Request.Query["status"] == "Failed")">Failed</option>
                </select>
                <div class="input-group" style="width: 250px;">
                    <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control bg-light border-0 small" 
                           placeholder="Search customer or pet..." value="@Context.Request.Query["search"]">
                </div>
            </form>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr class="small text-uppercase text-muted fw-bold">
                    <th class="ps-4">Trx ID</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Pet Adopted</th>
                    <th>Amount</th>
                    <th class="pe-4">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">#@t.GetProperty("transactionId")</td>
                            <td class="text-muted small">@t.GetProperty("transactionDate").GetString()?.Split('T')[0]</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center fw-bold text-muted" style="width: 30px; height: 30px; font-size: 0.7rem;">
                                        @t.GetProperty("customerName").GetString()?[0]
                                    </div>
                                    <span class="fw-medium">@t.GetProperty("customerName")</span>
                                </div>
                            </td>
                            <td class="fw-bold">@t.GetProperty("petName")</td>
                            <td class="fw-bold text-dark">$@t.GetProperty("amount")</td>
                            <td class="pe-4">
                                @{
                                    var status = t.GetProperty("transactionStatus").GetString();
                                    var badgeClass = status == "Success" ? "bg-success" : "bg-danger";
                                }
                                <span class="badge @badgeClass bg-opacity-10 text-@status.ToLower() rounded-pill px-3 py-2" style="font-size: 0.75rem;">
                                    <i class="fa-solid fa-circle me-1" style="font-size: 0.4rem;"></i> @status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-receipt fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">No transactions recorded yet.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <style>
        .text-success { color: #27ae60 !important; }
        .text-danger { color: #eb5757 !important; }
    </style>
}
