@{
    ViewData["Title"] = "Payment Failed";
}

<div class="row justify-content-center align-items-center min-vh-100" style="margin-top: -70px;">
    <div class="col-md-6 text-center">
        <div class="custom-card border-0 shadow-lg p-5">
            <div class="mb-4">
                <div class="bg-danger bg-opacity-10 d-inline-block p-4 rounded-circle mb-3">
                    <i class="fa-solid fa-circle-xmark fa-5x text-danger"></i>
                </div>
            </div>
            <h1 class="fw-bold mb-2">Oops!</h1>
            <h4 class="text-muted mb-4">Transaction Failed</h4>
            <p class="text-muted mb-5">Something went wrong while processing your payment. Please don't worry—no money was deducted from your account. You can try again or contact our support team.</p>
            
            <div class="d-flex gap-3 justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-3 fw-bold">
                    Retry Adoption
                </a>
                <a href="#" class="btn btn-light rounded-pill px-5 py-3 fw-bold text-muted">
                    Contact Support
                </a>
            </div>
        </div>
    </div>
</div>
