@{
    ViewData["Title"] = "Success";
}

<div class="row justify-content-center align-items-center min-vh-100" style="margin-top: -70px;">
    <div class="col-md-6 text-center">
        <div class="custom-card border-0 shadow-lg p-5">
            <div class="mb-4">
                <div class="bg-success bg-opacity-10 d-inline-block p-4 rounded-circle mb-3">
                    <i class="fa-solid fa-circle-check fa-5x text-success"></i>
                </div>
            </div>
            <h1 class="fw-bold mb-2">Congratulations!</h1>
            <h4 class="text-muted mb-4">@ViewBag.PetName has a new home!</h4>
            <p class="text-muted mb-5">Your adoption request has been successfully processed. You can now see @ViewBag.PetName in your dashboard and track their health records.</p>
            
            <div class="d-flex gap-3 justify-content-center">
                <a asp-controller="Customer" asp-action="Dashboard" class="btn btn-primary rounded-pill px-5 py-3 fw-bold">
                    Go to My Dashboard
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-light rounded-pill px-5 py-3 fw-bold text-muted">
                    Back to Marketplace
                </a>
            </div>
        </div>
    </div>
</div>


