@{
    ViewData["Title"] = "About Us";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Hero Section -->
        <div class="custom-card border-0 shadow-sm p-5 mb-5 text-center bg-primary text-white overflow-hidden position-relative">
            <div class="position-absolute top-0 start-0 w-100 h-100 opacity-10" style="background-image: url('https://www.transparenttextures.com/patterns/paws.png');"></div>
            <div class="position-relative z-index-1">
                <h1 class="display-4 fw-bold mb-3">Our Mission at Waggles</h1>
                <p class="lead mb-0">Connecting every pet with a loving forever home since 2024.</p>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-md-7">
                <h2 class="fw-bold mb-4">Who We Are</h2>
                <p class="text-muted lead">Waggles is more than just a pet shop; we are a community of animal lovers dedicated to the well-being of every creature that passes through our doors.</p>
                <p class="text-muted">Founded on the principle of "Compassion First," we work closely with trusted suppliers and local veterinarians to ensure that every pet is healthy, happy, and ready for their new family. Our state-of-the-art facility provides a safe haven for pets while they wait for their soulmates.</p>
                
                <div class="mt-5">
                    <h3 class="fw-bold mb-4">Our Core Values</h3>
                    <div class="d-flex gap-4 mb-4">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; flex-shrink: 0;">
                            <i class="fa-solid fa-heart fa-xl"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold">Unconditional Love</h5>
                            <p class="text-muted small">We treat every animal with the same care and affection we give our own pets.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-4 mb-4">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; flex-shrink: 0;">
                            <i class="fa-solid fa-shield-dog fa-xl"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold">Health & Safety</h5>
                            <p class="text-muted small">Strict veterinary checks and high-quality nutrition are our top priorities.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-4">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; flex-shrink: 0;">
                            <i class="fa-solid fa-handshake fa-xl"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold">Trustworthy Partners</h5>
                            <p class="text-muted small">We only work with suppliers who share our ethical standards for animal care.</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-5">
                <div class="custom-card border-0 shadow-sm p-0 overflow-hidden mb-4">
                    <img src="https://images.unsplash.com/photo-1516734212186-a967f81ad0d7?auto=format&fit=crop&w=600&q=80" class="w-100" style="height: 300px; object-fit: cover;" alt="Our Shop">
                    <div class="p-4">
                        <h5 class="fw-bold mb-2 text-dark">Visit Our Shop</h5>
                        <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot me-2"></i> 123 Paws Avenue, Pet City</p>
                    </div>
                </div>
                
                <div class="bg-white custom-card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-3">Quick Contacts</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3 d-flex align-items-center">
                            <i class="fa-solid fa-phone text-primary me-3"></i>
                            <span class="text-muted">+1 (555) WAGGLES</span>
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <i class="fa-solid fa-envelope text-primary me-3"></i>
                            <span class="text-muted">hello@waggles.com</span>
                        </li>
                        <li class="d-flex align-items-center">
                            <i class="fa-solid fa-clock text-primary me-3"></i>
                            <span class="text-muted">Mon - Sat: 9am - 8pm</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .z-index-1 { z-index: 1; }
</style>
