@model PetManagementSystem.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change / Reset Password";
}

<div class="row justify-content-center align-items-center min-vh-100" style="margin-top: -70px;">
    <div class="col-md-5">
        <div class="custom-card border-0 shadow-lg p-5">
            <div class="text-center mb-5">
                <div class="bg-primary bg-opacity-10 d-inline-block p-4 rounded-circle mb-3">
                    <i class="fa-solid fa-key fa-3x text-primary"></i>
                </div>
                <h2 class="fw-bold">Change Password</h2>
                <p class="text-muted">Enter your details to change your password</p>
            </div>

            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Role" class="form-label fw-bold small text-uppercase">Role</label>
                    <select asp-for="Role" class="form-select bg-light border-0 py-2">
                        <option value="Customer">Customer</option>
                        <option value="Employee">Employee</option>
                        <option value="Supplier">Supplier</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-bold small text-uppercase">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                        <input asp-for="Email" class="form-control bg-light border-0 py-2" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="OldPassword" class="form-label fw-bold small text-uppercase">Current Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-solid fa-lock text-muted"></i></span>
                        <input asp-for="OldPassword" class="form-control bg-light border-0 py-2" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="OldPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label fw-bold small text-uppercase">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-solid fa-lock text-muted"></i></span>
                        <input asp-for="NewPassword" class="form-control bg-light border-0 py-2" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="ConfirmNewPassword" class="form-label fw-bold small text-uppercase">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-solid fa-check text-muted"></i></span>
                        <input asp-for="ConfirmNewPassword" class="form-control bg-light border-0 py-2" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-sm">
                    Update Password
                </button>

                <div class="text-center mt-4">
                    <p class="text-muted small">Remembered your password? <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Back to Login</a></p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}