@model PetManagementSystem.Web.Models.CustomerDashboardViewModel
@{
    ViewData["Title"] = "My Profile";
    var profile = Model?.Profile;
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="fa-solid fa-id-card fa-2x text-primary"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-0">My Account Profile</h2>
                <p class="text-muted mb-0">View and manage your personal information and companion list.</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Detailed Profile View -->
    <div class="col-lg-8">
        <div class="custom-card border-0 shadow-sm p-5">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <h4 class="fw-bold mb-0">Personal Information</h4>
                <button class="btn btn-outline-primary btn-sm rounded-pill px-4 fw-bold">Edit Profile</button>
            </div>
            
            <div class="row g-4">
                @if (profile != null)
                {
                    <div class="col-md-6">
                        <label class="small text-muted d-block text-uppercase fw-bold mb-1">First Name</label>
                        <div class="p-3 bg-light rounded-3 fw-bold text-dark">
                            @profile.FirstName
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="small text-muted d-block text-uppercase fw-bold mb-1">Last Name</label>
                        <div class="p-3 bg-light rounded-3 fw-bold text-dark">
                            @profile.LastName
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="small text-muted d-block text-uppercase fw-bold mb-1">Email Address</label>
                        <div class="p-3 bg-light rounded-3 fw-bold text-dark">
                            @profile.Email
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="small text-muted d-block text-uppercase fw-bold mb-1">Phone Number</label>
                        <div class="p-3 bg-light rounded-3 fw-bold text-dark">
                            @(profile.PhoneNumber ?? "Not provided")
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-warning">
                            Profile information could not be loaded. Please try again later.
                        </div>
                    </div>
                }
            </div>

            <h5 class="fw-bold mt-5 mb-4">Shipping & Delivery</h5>
            <div class="p-4 bg-light rounded-4 border border-dashed border-primary border-opacity-25">
                @if (profile?.Address != null)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <small class="text-muted d-block">Street Address</small>
                            <span class="fw-bold">@profile.Address.Street</span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">City</small>
                            <span class="fw-bold">@profile.Address.City</span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">State/Zip</small>
                            <span class="fw-bold">@profile.Address.State @profile.Address.ZipCode</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="fa-solid fa-map-location-dot fa-2x text-muted opacity-50 mb-2"></i>
                        <p class="small text-muted mb-0">No shipping address on file.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Companions Column -->
    <div class="col-lg-4">
        <div class="custom-card border-0 shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">My Companions</h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary rounded-pill">@(Model.Transactions?.Count() ?? 0)</span>
                    @if (Model.Transactions?.Count() == 10)
                    {
                        <a asp-action="Transactions" class="small fw-bold text-decoration-none">View All</a>
                    }
                </div>
            </div>

            <div class="d-flex flex-column gap-3">
                @if (Model.Transactions != null && Model.Transactions.Any())
                {
                    foreach (var t in Model.Transactions)
                    {
                        <div class="p-3 bg-white border rounded-4 shadow-sm hover-shadow transition-all">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                    <i class="fa-solid fa-paw text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0">@t.PetName</h6>
                                    <small class="text-muted">Adopted: @(t.TransactionDate?.ToString("MMM yyyy") ?? "Recent")</small>
                                </div>
                                <i class="fa-solid fa-chevron-right ms-auto text-muted opacity-50"></i>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="mb-4 text-muted opacity-25">
                            <i class="fa-solid fa-dog fa-4x"></i>
                        </div>
                        <h6 class="fw-bold">No pets yet</h6>
                        <p class="small text-muted mb-4">Your future best friend is waiting in our marketplace.</p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary w-100 rounded-pill fw-bold py-2 shadow-sm">
                            Browse Pets
                        </a>
                    </div>
                }
            </div>
            
            @if (Model.Transactions != null && Model.Transactions.Any())
            {
                <div class="mt-5 p-4 bg-primary bg-opacity-10 rounded-4 text-center">
                    <p class="small text-muted mb-3">Want to add more members to your family?</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">Visit Marketplace</a>
                </div>
            }
        </div>
    </div>
</div>
