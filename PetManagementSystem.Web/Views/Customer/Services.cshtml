@using System.Text.Json
@{
    ViewData["Title"] = "Pet Care & Services";
    var grooming = ViewBag.Grooming as IEnumerable<dynamic>;
    var vaccinations = ViewBag.Vaccinations as IEnumerable<dynamic>;
}

<div class="row mb-5">
    <div class="col-12">
        <div class="custom-card border-0 shadow-sm p-5 text-white" style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); border-radius: 30px;">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="fw-800 display-4 mb-3">Pet Wellness Center</h1>
                    <p class="lead opacity-75">Professional care for your furry friends. From styling to health checks, we've got you covered.</p>
                </div>
                <div class="col-md-4 text-end">
                    <i class="fas fa-hand-holding-heart fa-6x opacity-25"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Grooming Services -->
    <div class="col-lg-8">
        <div class="custom-card border-0 shadow-sm p-4 h-100">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-4 me-3">
                    <i class="fas fa-cut text-primary fa-lg"></i>
                </div>
                <h3 class="fw-bold mb-0">Professional Grooming</h3>
            </div>

            <div class="row g-3">
                @if (grooming != null && grooming.Any())
                {
                    @foreach (var service in grooming)
                    {
                        <div class="col-md-6">
                            <div class="p-4 rounded-4 border border-light bg-light bg-opacity-50 h-100 transition-hover">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold mb-0 text-dark">@service.GetProperty("serviceName").GetString()</h5>
                                    <span class="badge bg-primary rounded-pill">$@service.GetProperty("price").GetDecimal().ToString("F2")</span>
                                </div>
                                <p class="text-muted small mb-0">Experience the best styling and care for your pet.</p>
                                <div class="mt-3">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3">Book Appointment</button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <img src="https://cdn-icons-png.flaticon.com/512/4081/4081927.png" width="80" class="opacity-25 mb-3" />
                        <p class="text-muted">No grooming services available at the moment.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Vaccinations -->
    <div class="col-lg-4">
        <div class="custom-card border-0 shadow-sm p-4 h-100">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-success bg-opacity-10 p-3 rounded-4 me-3">
                    <i class="fas fa-syringe text-success fa-lg"></i>
                </div>
                <h3 class="fw-bold mb-0">Vaccinations</h3>
            </div>

            <div class="list-group list-group-flush">
                @if (vaccinations != null && vaccinations.Any())
                {
                    @foreach (var vac in vaccinations)
                    {
                        <div class="list-group-item bg-transparent border-0 px-0 mb-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-1">@vac.GetProperty("vaccineName").GetString()</h6>
                                    <p class="text-muted x-small mb-0">
                                        Required every @vac.GetProperty("durationMonths").GetInt32() months
                                    </p>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-success">$@vac.GetProperty("price").GetDecimal().ToString("F2")</div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-4">No vaccination schedules found.</p>
                }
            </div>

            <div class="mt-4 p-3 bg-warning bg-opacity-10 rounded-4">
                <div class="d-flex">
                    <i class="fas fa-info-circle text-warning mt-1 me-2"></i>
                    <p class="x-small mb-0 text-dark">
                        <strong>Health Tip:</strong> Regular vaccinations are crucial for your pet's long-term health and protection.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        border-color: var(--bs-primary) !important;
        background: white !important;
    }
    .x-small { font-size: 0.75rem; }
    .fw-800 { font-weight: 800; }
</style>
