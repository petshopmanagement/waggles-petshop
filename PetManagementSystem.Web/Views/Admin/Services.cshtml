@model PetManagementSystem.Web.Models.AdminServicesViewModel
@{
    ViewData["Title"] = "Health & Grooming Services";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="fw-bold mb-1">Health & Grooming</h2>
        <p class="text-muted mb-0">Manage vaccinations and grooming packages available to customers.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addGroomingModal">
            <i class="fa-solid fa-plus me-2"></i> Add Grooming
        </button>
        <button class="btn btn-outline-primary rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addVaccinationModal">
            <i class="fa-solid fa-plus me-2"></i> Add Vaccination
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-5" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-5" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> <strong>Please correct the following errors:</strong>
        <div asp-validation-summary="All" class="mb-0 mt-2 small"></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Grooming Services Section -->
    <div class="col-lg-6">
        <div class="custom-card border-0 shadow-sm h-100 p-4">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 p-3 rounded-4 me-3">
                    <i class="fa-solid fa-scissors text-primary fa-lg"></i>
                </div>
                <h4 class="fw-bold mb-0">Grooming Packages</h4>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle border-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0 rounded-start-3 small fw-bold text-uppercase text-muted">Service</th>
                            <th class="border-0 small fw-bold text-uppercase text-muted">Price</th>
                            <th class="border-0 rounded-end-3 small fw-bold text-uppercase text-muted">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.GroomingServices)
                        {
                            <tr>
                                <td class="py-3">
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 200px;">@item.Description</small>
                                </td>
                                <td class="py-3 fw-bold text-primary">$@item.Price</td>
                                <td class="py-3">
                                    <span class="badge @(item.IsAvailable ? "bg-success" : "bg-secondary") rounded-pill px-3">
                                        @(item.IsAvailable ? "Available" : "Hidden")
                                    </span>
                                </td>
                            </tr>
                        }
                        @if (!Model.GroomingServices.Any())
                        {
                            <tr><td colspan="3" class="text-center py-4 text-muted">No grooming services found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Vaccinations Section -->
    <div class="col-lg-6">
        <div class="custom-card border-0 shadow-sm h-100 p-4">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-info bg-opacity-10 p-3 rounded-4 me-3">
                    <i class="fa-solid fa-syringe text-info fa-lg"></i>
                </div>
                <h4 class="fw-bold mb-0">Vaccinations</h4>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle border-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0 rounded-start-3 small fw-bold text-uppercase text-muted">Name</th>
                            <th class="border-0 small fw-bold text-uppercase text-muted">Price</th>
                            <th class="border-0 rounded-end-3 small fw-bold text-uppercase text-muted">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Vaccinations)
                        {
                            <tr>
                                <td class="py-3">
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 200px;">@item.Description</small>
                                </td>
                                <td class="py-3 fw-bold text-primary">$@item.Price</td>
                                <td class="py-3">
                                    <span class="badge @(item.IsAvailable ? "bg-success" : "bg-secondary") rounded-pill px-3">
                                        @(item.IsAvailable ? "Available" : "Hidden")
                                    </span>
                                </td>
                            </tr>
                        }
                        @if (!Model.Vaccinations.Any())
                        {
                            <tr><td colspan="3" class="text-center py-4 text-muted">No vaccinations found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Grooming Modal -->
<div class="modal fade" id="addGroomingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">New Grooming Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateGrooming" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Service Name</label>
                        <input name="Name" class="form-control bg-light border-0 py-2" placeholder="e.g. Full Bath & Style" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Description</label>
                        <textarea name="Description" class="form-control bg-light border-0 py-2" rows="3" placeholder="What's included..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Price ($)</label>
                            <input name="Price" type="number" step="0.01" min="0.01" class="form-control bg-light border-0 py-2" placeholder="0.00" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Status</label>
                            <select name="IsAvailable" class="form-select bg-light border-0 py-2">
                                <option value="true">Available</option>
                                <option value="false">Hidden</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Create Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Vaccination Modal -->
<div class="modal fade" id="addVaccinationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add Vaccination</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateVaccination" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Vaccine Name</label>
                        <input name="Name" class="form-control bg-light border-0 py-2" placeholder="e.g. Rabies, DHPP" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Description</label>
                        <textarea name="Description" class="form-control bg-light border-0 py-2" rows="3" placeholder="Purpose or details..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Price ($)</label>
                            <input name="Price" type="number" step="0.01" min="0.01" class="form-control bg-light border-0 py-2" placeholder="0.00" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Status</label>
                            <select name="IsAvailable" class="form-select bg-light border-0 py-2">
                                <option value="true">Available</option>
                                <option value="false">Hidden</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Add Vaccine</button>
                </div>
            </form>
        </div>
    </div>
</div>
