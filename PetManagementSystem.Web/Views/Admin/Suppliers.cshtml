@model IEnumerable<PetManagementSystem.Web.Models.SupplierViewModel>
@{
    ViewData["Title"] = "All Suppliers";
}

<div class="row mb-5">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Suppliers</h2>
        <p class="text-muted">All registered suppliers providing pets to Waggles.</p>
    </div>
    <div class="col-md-4 text-md-end">
        <span class="badge bg-warning text-dark rounded-pill px-4 py-2 fs-6">@Model.Count() Total</span>
    </div>
</div>

<div class="card custom-card border-0 shadow-sm p-0 overflow-hidden">
    <div class="p-4 border-bottom bg-white">
        <h5 class="fw-bold mb-0">
            <i class="fa-solid fa-truck me-2 text-warning"></i>Supplier Directory
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr class="small text-uppercase text-muted fw-bold">
                    <th class="ps-4">#</th>
                    <th>Company</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th class="pe-4">Location</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int i = 1;
                    foreach (var sup in Model)
                    {
                        var city = sup.Address?.City ?? "";
                        var state = sup.Address?.State ?? "";
                        var location = string.Join(", ", new[] { city, state }.Where(s => !string.IsNullOrEmpty(s)));

                        <tr>
                            <td class="ps-4 text-muted small">@i</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold"
                                         style="width: 38px; height: 38px; font-size: 0.85rem; flex-shrink: 0;">
                                        @(sup.Name?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold">@(sup.Name ?? "—")</h6>
                                        <small class="text-muted">ID: #@sup.SupplierId</small>
                                    </div>
                                </div>
                            </td>
                            <td class="small fw-medium">@(sup.ContactPerson ?? "—")</td>
                            <td class="small">@(sup.Email ?? "—")</td>
                            <td class="small">@(sup.PhoneNumber ?? "—")</td>
                            <td class="pe-4 small text-muted">@(string.IsNullOrEmpty(location) ? "—" : location)</td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-truck fa-2x mb-3 d-block opacity-30"></i>
                            No suppliers found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
