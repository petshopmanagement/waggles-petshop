@using System.Text.Json
@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row mb-5">
    <div class="col-12">
        <h2 class="fw-bold mb-1">Overview</h2>
        <p class="text-muted">Welcome back! Here's a snapshot of Waggles today.</p>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-4 col-lg">
        <a asp-action="Employees" class="text-decoration-none">
            <div class="stat-card bg-primary shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small fw-bold text-uppercase opacity-75">Employees</span>
                    <i class="fa-solid fa-user-tie"></i>
                </div>
                <h2 class="fw-bold mb-0">@ViewBag.EmployeeCount</h2>
                <small class="opacity-75">View all →</small>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg">
        <a asp-action="Customers" class="text-decoration-none">
            <div class="stat-card bg-success shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small fw-bold text-uppercase opacity-75">Customers</span>
                    <i class="fa-solid fa-users"></i>
                </div>
                <h2 class="fw-bold mb-0">@ViewBag.CustomerCount</h2>
                <small class="opacity-75">View all →</small>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg">
        <a asp-action="Suppliers" class="text-decoration-none">
            <div class="stat-card bg-warning shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small fw-bold text-uppercase opacity-75">Suppliers</span>
                    <i class="fa-solid fa-truck"></i>
                </div>
                <h2 class="fw-bold mb-0">@ViewBag.SupplierCount</h2>
                <small class="opacity-75">View all →</small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg">
        <div class="stat-card bg-info shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="small fw-bold text-uppercase opacity-75">Active Pets</span>
                <i class="fa-solid fa-dog"></i>
            </div>
            <h2 class="fw-bold mb-0">@ViewBag.PetCount</h2>
            <small class="opacity-75">Currently available</small>
        </div>
    </div>
    <div class="col-md-6 col-lg">
        <a asp-action="PetFood" class="text-decoration-none">
            <div class="stat-card bg-danger shadow-sm h-100" style="background-color: #ff4757 !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small fw-bold text-uppercase opacity-75">Pet Food</span>
                    <i class="fa-solid fa-bowl-food"></i>
                </div>
                <h2 class="fw-bold mb-0">@ViewBag.FoodCount</h2>
                <small class="opacity-75">Manage inventory →</small>
            </div>
        </a>
    </div>
</div>

<!-- Recent Transactions -->
<div class="row">
    <div class="col-12">
        <div class="custom-card border-0 shadow-sm p-0 overflow-hidden">
            <div class="p-4 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="fw-bold mb-0">Recent Transactions</h5>
                <a asp-controller="Transactions" asp-action="Index"
                   class="btn btn-sm btn-light rounded-pill px-3 fw-bold">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase text-muted fw-bold">
                            <th class="ps-4">Pet</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th class="pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var t in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                                                 style="width: 40px; height: 40px;">
                                                <i class="fa-solid fa-paw text-muted"></i>
                                            </div>
                                            <span class="fw-bold">@t.GetProperty("petName")</span>
                                        </div>
                                    </td>
                                    <td class="small text-muted">@t.GetProperty("transactionDate")</td>
                                    <td class="fw-bold">$@t.GetProperty("amount")</td>
                                    <td class="pe-4">
                                        @{
                                            var status = t.GetProperty("transactionStatus").GetString();
                                            var badge  = status == "Success" ? "bg-success" : "bg-danger";
                                        }
                                        <span class="badge @badge bg-opacity-10 text-@(status?.ToLower()) rounded-pill px-3 py-2">
                                            @status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">No recent transactions.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .stat-card { cursor: pointer; transition: transform .15s ease, box-shadow .15s ease; }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.12) !important; }
        .bg-warning { background-color: #f39c12 !important; }
        .bg-info    { background-color: #4facfe !important; }
    </style>
}
