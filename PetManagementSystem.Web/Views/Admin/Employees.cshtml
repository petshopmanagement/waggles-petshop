@model IEnumerable<PetManagementSystem.Web.Models.EmployeeViewModel>
@{
    ViewData["Title"] = "All Employees";
}

<div class="row mb-5">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Employees</h2>
        <p class="text-muted">All registered staff members at Waggles Pet Shop.</p>
    </div>
    <div class="col-md-4 text-md-end">
        <span class="badge bg-primary rounded-pill px-4 py-2 fs-6">@Model.Count() Total</span>
    </div>
</div>

<div class="card custom-card border-0 shadow-sm p-0 overflow-hidden">
    <div class="p-4 border-bottom bg-white">
        <h5 class="fw-bold mb-0">
            <i class="fa-solid fa-user-tie me-2 text-primary"></i>Employee Directory
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr class="small text-uppercase text-muted fw-bold">
                    <th class="ps-4">#</th>
                    <th>Name</th>
                    <th>Position</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Location</th>
                    <th class="pe-4 text-center">Pets Managed</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int i = 1;
                    foreach (var emp in Model)
                    {
                        var city = emp.Address?.City ?? "";
                        var state = emp.Address?.State ?? "";
                        var location = string.Join(", ", new[] { city, state }.Where(s => !string.IsNullOrEmpty(s)));

                        <tr>
                            <td class="ps-4 text-muted small">@i</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                         style="width: 38px; height: 38px; font-size: 0.85rem; flex-shrink: 0;">
                                        @(emp.FirstName?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold">@emp.FullName</h6>
                                        <small class="text-muted">ID: #@emp.EmployeeId</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                                    @(emp.Position ?? "—")
                                </span>
                            </td>
                            <td class="small">@(emp.Email ?? "—")</td>
                            <td class="small">@(emp.PhoneNumber ?? "—")</td>
                            <td class="small text-muted">@(string.IsNullOrEmpty(location) ? "—" : location)</td>
                            <td class="pe-4 text-center">
                                @{
                                    int petCount = emp.Pets?.Count ?? 0;
                                }

                                @if (petCount > 0)
                                {
                                    <span class="badge rounded-pill px-3 py-2"
                                          style="background-color: #e8f7ee; color: #198754; font-weight: 600;">
                                        @petCount pets
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-2"
                                          style="background-color: #f1f3f5; color: #6c757d; font-weight: 600;">
                                        0 pets
                                    </span>
                                }
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-user-slash fa-2x mb-3 d-block opacity-30"></i>
                            No employees found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
